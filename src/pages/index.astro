---
import Layout from '../layouts/Layout.astro';
import countries from '../data/countries.json';

const sortedCountries = countries.sort((a: any, b: any) => 
  (a.name || '').localeCompare(b.name || '')
);
---

<Layout>
  <main id="main" class="home-main" aria-label="Browse countries">
    <div class="filters">
      <label class="sr-only" for="search">Search for a country</label>
      <input type="text" id="search" placeholder="Search for a country..." aria-controls="country-grid" />
      <button id="region-filter-button" type="button" class="region-filter" popovertarget="continent" aria-controls="continent" aria-haspopup="listbox" aria-expanded="false">Filter by Region</button>
      <menu popover id="continent" role="listbox" aria-labelledby="region-filter-button">
        <li>
          <button type="button" class="region-opt region-opt--active" data-region="all" role="option" aria-selected="true">
            All
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
        <li>
          <button type="button" class="region-opt" data-region="Africa" role="option" aria-selected="false">
            Africa
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
        <li>
          <button type="button" class="region-opt" data-region="Americas" role="option" aria-selected="false">
            Americas
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
        <li>
          <button type="button" class="region-opt" data-region="Asia" role="option" aria-selected="false">
            Asia
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
        <li>
          <button type="button" class="region-opt" data-region="Europe" role="option" aria-selected="false">
            Europe
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
        <li>
          <button type="button" class="region-opt" data-region="Oceania" role="option" aria-selected="false">
            Oceania
            <svg class="checkmark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </li>
      </menu>
    </div>

    <p id="results-status" class="sr-only" aria-live="polite"></p>
    <div class="cards" id="country-grid" role="list" aria-label="Countries">
      {/* We still map them here so the page isn't blank on initial load 
         (Great for SEO and speed).
      */}
      {sortedCountries.map((country: any, index: number) => (
        <a href={`/${country?.name?.toLowerCase().replace(/ /g, '-')}`} class="country-card" data-alpha3Code={country?.alpha3Code} role="listitem" aria-label={`View details for ${country?.name}`}>
          <section class="card">
            <img src={country?.flags?.svg} alt={country?.flags?.alt} loading={index < 8 ? 'eager' : 'lazy'} style={`view-transition-name: --flag-${country.alpha3Code};`}/>
            <h2 style={`view-transition-name: --name-${country.alpha3Code};`}>{country?.name}</h2>
            <p><strong>Population:</strong> {country?.population?.toLocaleString()}</p>
            <p><strong>Region:</strong> {country?.region}</p>
            <p><strong>Capital:</strong> {country?.capital || 'N/A'}</p>
          </section>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style lang="scss">
  .home-main {
    padding-block: 2rem;
    display: grid;
    grid-template-columns: minmax(1rem, 1fr) [filters-start cards-start] minmax(0, 79.5rem) [filters-end cards-end] minmax(1rem, 1fr);
    .cards {
      grid-column: cards;
    }
    
  }
  .filters {
    margin-block-end: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 0.5rem;
    grid-column: filters;
    position: sticky;
    top: 4.5rem;
    z-index: 1;
    .region-filter {
      inline-size: 12.5rem;
      block-size: 3.5rem;
      border-radius: var(--radius-3);
      display: flex;
      align-items: center;
      justify-content: space-around;
      anchor-name: --region-anchor;
      background-color: var(--clr-surface-container-low);
      color: var(--clr-on-surface-variant);
      box-shadow: var(--shadow-4);
      &::after {
        content: 'keyboard_arrow_down';
        font-size: 1.5rem;
        font-family: var(--font-family-icons);
        transition: transform 200ms ease;
        
      }
    }

    menu {
      inline-size: 12.5rem;
      padding-inline: 0.25rem;
      padding-block: 0.25rem;
      border: 0;
      border-radius: var(--radius-3);
      margin-block-start: 0.5rem;
      position: absolute;
      position-anchor: --region-anchor;
      position-area: bottom center;
      list-style: none;
      text-decoration: none;
      background-color: var(--clr-surface-container-low);
      color: var(--clr-on-surface-variant);
      box-shadow: var(--shadow-3);
      isolation: isolate;
      &:hover{
          color: oklch(from var(--clr-on-surface-variant) l c h / 0.5);
      }
      li .region-opt {
        inline-size: 100%;
        block-size: 3rem;
        padding-inline: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        background-color: transparent;
        color: inherit;
        .checkmark {
          inline-size: 1.25rem;
          block-size: 1.25rem;
          fill: none;
          stroke: var(--clr-tertiary);
          stroke-width: 3;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-dasharray: 24;
          stroke-dashoffset: 24;
          opacity: 0;
          transition: stroke-dashoffset 400ms var(--ease-out-3), opacity 200ms ease;
}
        &--active{
          anchor-name: --region-selected;
          color: var(--clr-on-tertiary-container);
          .checkmark {
            opacity: 1;
            stroke-dashoffset: 0;
            transition-delay: 100ms;
          }
        }
        &:hover, &:focus-visible {
          anchor-name: --region-hover;
          color: var(--clr-on-tertiary-container);
        }
      }
      &::before {
        content: '';
        position: absolute;
        background-color: var(--clr-tertiary-container);
        border-radius: 0.75rem;
        opacity: 0;
        pointer-events: none;
        z-index: -1;
        transition: 
          inset-block-start 300ms var(--ease-elastic-5),
          inset-inline-start 300ms var(--ease-elastic-5),
          inline-size 300ms var(--ease-elastic-5),
          block-size 300ms var(--ease-elastic-5),
          opacity 150ms;
        position-anchor: --region-selected;
        inset-block-start: anchor(top);
        inset-inline-start: anchor(left);
        inline-size: anchor-size(width);
        block-size: anchor-size(height);
        opacity: 1;
      }
      &:has(.region-opt:hover)::before{
        position-anchor: --region-hover;
      }
    }
    &:has(menu:popover-open) .region-filter::after {
      transform: rotate(-180deg);
    }
  }
  input[type="text"] {
    inline-size: min(100%, 66.5rem);
    block-size: 3.5rem;
    padding: 0.5rem;
    border: 0;
    border-radius: var(--radius-3);
    flex: 1 1 30rem;
    background-color: var(--clr-surface-container-low);
    color: var(--clr-on-surface-variant);
    box-shadow: var(--shadow-4);
    &:focus-visible {
      outline: 2px solid var(--clr-primary);
    }
  }
</style>

<script define:vars={{ sortedCountries }}>
  // 'define:vars' safely passes your server data into the client script
  const searchInput = document.querySelector('#search');
  const regionMenu = document.querySelector('#continent');
  const regionFilterButton = document.querySelector('#region-filter-button');
  const resultsStatus = document.querySelector('#results-status');
  const regionBtns = document.querySelectorAll('.region-opt');

  let state = {
    search: '',
    region: 'all'
  };

  function updateUI() {
    // 1. Filter the JSON data directly
    const filtered = sortedCountries.filter(c => {
      const matchesSearch = c.name.toLowerCase().includes(state.search.toLowerCase());
      const matchesRegion = state.region === 'all' || c.region === state.region;
      return matchesSearch && matchesRegion;
    });

    // 2. Efficiently update the DOM
    // We target the existing cards by their unique CCA3 ID to decide visibility
    const cards = document.querySelectorAll('.country-card');
    
    // Create a Set of CCA3 codes that should be visible for O(1) lookup
    const visibleIds = new Set(filtered.map(c => c.alpha3Code));

    cards.forEach(card => {
      const id = card.getAttribute('data-alpha3Code');
      card.style.display = visibleIds.has(id) ? 'block' : 'none';
    });

    if (resultsStatus) {
      const count = filtered.length;
      const label = count === 1 ? 'country' : 'countries';
      resultsStatus.textContent = `${count} ${label} shown`;
    }
  }

  // Event Listeners
  searchInput.addEventListener('input', (e) => {
    state.search = e.target.value;
    updateUI();
  });

  regionBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      state.region = btn.dataset.region;
      regionBtns.forEach(b => {
        b.classList.remove('region-opt--active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('region-opt--active');
      btn.setAttribute('aria-selected', 'true');
      updateUI();
    });
  });

  regionMenu?.addEventListener('toggle', () => {
    regionFilterButton?.setAttribute('aria-expanded', String(regionMenu.matches(':popover-open')));
  });

  updateUI();
</script>