---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const response = await fetch('https://restcountries.com/v3.1/all?fields=name,flags,population,region,capital');
const countries = await response.json();
type Country = {
  name: {
    common?: string;
  };
  flags: {
    svg?: string;
    alt?: string;
  };
  population?: number;
  region?: string;
  capital?: string[];
};
---

<Layout>
  <main id="main" class="home-main">
    <div class="filters">
      <input type="text" name="search" id="search" placeholder="Search for a country..." />
      <select name="continent" id="continent">
        <option value="">Filter by Region</option>
        <option value="Africa">Africa</option>
        <option value="Americas">Americas</option>
        <option value="Asia">Asia</option>
        <option value="Europe">Europe</option>
        <option value="Oceania">Oceania</option>
      </select>
    </div>
    <div class="cards">
      {countries.sort((a: Country, b: Country) => {
        const nameA = a.name.common || '';
        const nameB = b.name.common || '';
        return nameA.localeCompare(nameB);
      }).map((country: Country) => (
        <a href={`/${country.name.common?.toLowerCase().replace(/\s+/g, '-')}`}>
          <section class="card">
          {country.flags.svg && <Image src={country.flags.svg} format='svg' alt ={country.flags.alt || country.name.common || ''} width={500} height={300} loading="lazy"/>}
          <h2>{country.name.common}</h2>
          <p><strong>Population:</strong> {country.population?.toLocaleString()}</p>
          <p><strong>Region:</strong> {country.region}</p>
          <p><strong>Capital:</strong> {country.capital?.join(', ')}</p>
    </section>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style lang="scss">
  body {
    background-color: var(--clr-surface);
  }
  .home-main {
    padding-block: 2rem;
    padding-inline: 1.5rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-block-end: 1.5rem;
  }
  input[type="text"] {
    max-inline-size: 30rem;
    min-inline-size: 0;
    block-size: 3.5rem;
    padding: 0.5rem;
    border: 1px solid var(--clr-outline);
    border-radius: 0.25rem;
    flex: 1 1 20rem;
  }
  select {
    flex: 0 0 auto;
    block-size: 3.5rem;
    padding-inline: 0.75rem;
    border-radius: 0.25rem;
    font-size: 1rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    > a {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform 220ms ease;
  }
  }
  .card {
    block-size: fit-content;
    border-radius: 12px;
    background-color: var(--clr-surface-container-highest);
    color: var(--clr-on-surface);
    overflow: hidden;
    transform: none;
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        opacity: 0;
        will-change: opacity;
        animation-name: scroll-slideUp;
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(block);
        animation-range: entry 10% cover 35%;
      }
    }
    &:hover{
      box-shadow: var(--elevation-1);
    }
    & img {
      inline-size: 100%;
      block-size: 10rem;
      border-radius: 0 0 12px 12px;
      display: block;
      object-fit: cover;
      object-fit: cover;
      shape-rendering: crispEdges;
      image-rendering: -webkit-optimize-contrast;
    }
    & h2 {
      margin: 1rem;
      font-size: 1.25rem;
    }
    & p {
      margin: 0.5rem 1rem;
      font-size: 0.9rem;
    }
  }

  

  @keyframes scroll-slideUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>