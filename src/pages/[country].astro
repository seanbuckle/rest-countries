---
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const response = await fetch("https://restcountries.com/v3.1/all?fields=name");
  const countries = await response.json();
  return countries.map((c: any) => {
    const slug = c.name.common.toLowerCase().replaceAll(' ', '-');
    return {
      params: { country: slug },
      props: { fullName: c.name.common }
    };
  });
}

const { country } = Astro.params as { country: string };

const countryName = country.replaceAll('-', ' ').replace(/guinea bissau/i, 'guinea-bissau').replace(/timor leste/i, 'timor-leste');
const response = await fetch(`https://restcountries.com/v3.1/name/${countryName}?fullText=true`);
const countryData = await response.json();
console.log(countryData);

let borderCountries: string[] = [];
if (countryData && countryData.length > 0 && countryData[0].borders) {
  const codes = countryData[0].borders.join(',');
  const borderRes = await fetch(`https://restcountries.com/v3.1/alpha?codes=${codes}&fields=name,cca3`);
  borderCountries = await borderRes.json();
}
type NativeName = {
  common: string;
};

type Country = {
  name: {
    common: string;
    nativeName: {
      [key: string]: NativeName;
    };
  };
  flags: {
    svg: string;
    alt?: string;
  };
  population: number;
  region: string;
  subregion: string;
  capital: string[];
  tld: string[];
  currencies: {
    [key: string]: {
      name: string;
      symbol: string;
    };
  };
  borders?: string[];
};

---

<Layout>
  <main id="main">
    {countryData && countryData.length > 0 ? (
      <section class="card">
        <img id="country-flag" crossorigin="anonymous" src={countryData[0].flags.svg} alt={countryData[0].flags.alt || countryData[0].name.common} />
        <h2>{countryData[0].name.common}</h2>
        <p><strong>Native Name:</strong> 
        {(Object.values(countryData[0]?.name?.nativeName || {})[0] as NativeName)?.common || 'N/A'}</p>
        <p><strong>Population:</strong> {countryData[0].population.toLocaleString()}</p>
        <p><strong>Region:</strong> {countryData[0].region}</p>
        <p><strong>Subregion:</strong> {countryData[0].subregion}</p>
        <p><strong>Capital:</strong> {countryData[0].capital?.join(', ') || 'N/A'}</p>
        <p><strong>Top Level Domain:</strong> {countryData[0].tld?.join(', ') || 'N/A'}</p>
        <p><strong>Currencies:</strong> {(Object.values(countryData[0]?.currencies || {})[0] as { name: string; symbol: string })?.name || 'N/A'}</p>
        <p><strong>Border countries:</strong> {borderCountries.length > 0 ? (
    borderCountries.map((b: any) => (
      <a href={`/${b.name.common.toLowerCase().replaceAll(' ', '-')}`}>
        {b.name.common}
      </a>
    ))
  ) : (
    "None"
  )}</p>
      </section>
    ) : (
      <p>Country not found.</p>
    )}
  </main>
</Layout>

<style lang="scss">
  #main {
    padding: 2rem 5.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 600px;
  }

  img {
    width: 500px;
    aspect-ratio: 1/1;
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 0;
    font-size: 2rem;
  }

  p {
    margin: 0.25rem 0;

    font-size: 1.125rem;
  }
  a {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.25rem 0.5rem;
    background-color: var(--clr-surface-container);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  import { getColorSync } from 'colorthief';

  const scheduleApplyFlagColor = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        applyFlagColor();
      });
    });
  };

  const applyFlagColor = () => {
    const img = document.querySelector('#country-flag');
    if (!(img instanceof HTMLImageElement)) return;

    const handleFlagLoad = () => {
      try {
        const color = getColorSync(img);
        if (color) {
          document.documentElement.style.setProperty('--clr-base', color.css('oklch'));
        }
      } catch (error) {
        console.error('Could not extract dominant flag color:', error);
      }
    };

    if (img.complete) {
      handleFlagLoad();
    } else {
      img.addEventListener('load', handleFlagLoad, { once: true });
    }
  };

  scheduleApplyFlagColor();

  const globalState = globalThis as typeof globalThis & {
    __countryFlagColorListenerAttached__?: boolean;
  };

  if (!globalState.__countryFlagColorListenerAttached__) {
    document.addEventListener('astro:after-swap', scheduleApplyFlagColor);
    document.addEventListener('astro:page-load', scheduleApplyFlagColor);
    globalState.__countryFlagColorListenerAttached__ = true;
  }
</script>